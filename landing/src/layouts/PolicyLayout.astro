---
import '../styles/policy.css'

import BaseLayout from './BaseLayout.astro';
import { execFileSync } from 'node:child_process';

const repoRoot = execFileSync('git', ['rev-parse', '--show-toplevel'], {
  encoding: 'utf8',
}).trim();

const {
  title,
  description,
  file,
} = Astro.props.content;

const committedAt = execFileSync(
    'git',
    ['-C', repoRoot, 'log', '-1', '--format=%cI', '--', file],
    { encoding: 'utf8' }
).trim();

const lastUpdated = committedAt ? new Date(committedAt) : new Date();
const displayDate = lastUpdated && new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'America/Los_Angeles',
}).format(lastUpdated);




---

<BaseLayout title={`${title} | MockScores - Mock Trial Software`} description={description} >
  <h1>{title}</h1>
  <p>Last updated: <time datetime={lastUpdated.toISOString()}>{displayDate}</time> </p>
  <slot />
</BaseLayout>