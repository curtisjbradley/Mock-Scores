{
  "name": "mock-scores",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/curtisjbradley/Mock-Scores#readme",
  "bugs": {
    "url": "https://github.com/curtisjbradley/Mock-Scores/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtisjbradley/Mock-Scores.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm run build -w shared  && npm run build -w frontend && npm run build -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "start": "npm run start -w backend",
    "prepare": "node -e \"if(process.env.NODE_ENV !== 'production') require('child_process').execSync('husky', {stdio:'inherit'})\"",
    "backend-coverage": "npm run build -w shared && cd backend && npm run test:coverage",
    "test": "npm run build -w shared && npm run test -w backend && npm run cy:run -w frontend"
  },
  "workspaces": [
    "frontend",
    "backend",
    "blockly-integration",
    "shared"
  ],
  "overrides": {
    "js-yaml": "4.2.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.2.0"
    }
  },
  "devDependencies": {
    "fallow": "^2.102.0"
  }
}
