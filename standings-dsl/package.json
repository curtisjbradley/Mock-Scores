{
  "name": "@mock-scores/standings-dsl",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "scripts": {
    "build": "npx tsc && npx tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}, null, 2))\" && npm run build:react",
    "build:react": "npx tsc -p tsconfig.react.json && node -e \"require('fs').copyFileSync('src/react/styles.css','dist/react/styles.css')\"",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@mock-scores/shared": "*",
    "s-expression": "3.1.1"
  },
  "peerDependencies": {
    "blockly": ">=12.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "blockly": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "blockly": "^12.0.0",
    "jest": "^30.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
